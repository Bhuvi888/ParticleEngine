{
  "name": "particle-morph",
  "version": "0.1.0",
  "description": "Zero-dependency particle engine with shape morphing, 3D projection, text and image formations.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "./dist/particle-morph.global.js",
  "module": "./dist/particle-morph.esm.js",
  "exports": {
    ".": {
      "import": "./dist/particle-morph.esm.js"
    },
    "./vanilla": {
      "import": "./dist/particle-morph.vanilla.esm.js",
      "default": "./dist/particle-morph.global.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "vanilla.js",
    "Particles.jsx",
    "useParticles.js",
    "ParticleEngine.js",
    "ParticleController.js",
    "ParticleRenderer.js",
    "ParticleStore.js",
    "utils.js",
    "README.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node tools/build.mjs",
    "demo": "node tools/serve.js",
    "serve": "node tools/serve.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "particles",
    "canvas",
    "animation",
    "morph",
    "react",
    "particle-background"
  ]
}
